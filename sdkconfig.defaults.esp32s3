# ESP32-S3-DevKitC-1 modules are N8 / N8R8 (8 MB flash) or larger.
# An image built for 8 MB still runs on a 16 MB module.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# DevKitC-1's USB socket goes through the UART bridge on GPIO43/44.
# The chip default is native USB-Serial/JTAG, which stays silent on that socket.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
